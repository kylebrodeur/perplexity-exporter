{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Thread": {
      "type": "object",
      "required": ["slug", "title", "created_at", "updated_at"],
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "model": { "type": "string" },
        "collection_uuid": { "type": "string" }
      }
    },
    "ThreadDetail": {
      "allOf": [
        { "$ref": "#/definitions/Thread" },
        {
          "type": "object",
          "required": ["steps"],
          "properties": {
            "steps": {
              "type": "array",
              "items": { "$ref": "#/definitions/ConversationStep" }
            },
            "description": { "type": "string" },
            "tags": { "type": "array", "items": { "type": "string" } },
            "visibility": { "type": "string", "enum": ["private", "public"] }
          }
        }
      ]
    },
    "ConversationStep": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/Source" }
        },
        "followups": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Source": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "snippet": { "type": "string" }
      }
    },
    "ExportOptions": {
      "type": "object",
      "properties": {
        "outputPath": { "type": "string" },
        "includeSteps": { "type": "boolean", "default": true },
        "maxThreads": { "type": "number", "default": 1000 },
        "parallel": { "type": "boolean", "default": false }
      }
    },
    "ExportResult": {
      "type": "object",
      "required": ["success", "threadCount"],
      "properties": {
        "success": { "type": "boolean" },
        "threadCount": { "type": "number" },
        "outputPath": { "type": "string" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "duration": { "type": "number" }
      }
    }
  }
}
