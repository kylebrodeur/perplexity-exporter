{
  "name": "perplexity-exporter",
  "version": "1.0.0",
  "description": "Export all threads from Perplexity",
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "perplexity-exporter": "dist/cli.js",
    "perplexity-export": "auto-export-playwright.js"
  },
  "files": [
    "dist",
    "auto-export.js",
    "auto-export-playwright.js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "capture": "node capture-requests.js",
    "analyze": "node analyze-capture.js",
    "configure": "node configure-export.js",
    "export": "node export-threads.js",
    "export-all": "node export-all.js",
    "extract-cookies": "node extract-cookies.js",
    "auto-export": "node auto-export.js",
    "auto-export-pw": "node auto-export-playwright.js",
    "playwright": "node auto-export-playwright.js",
    "codegen": "playwright codegen https://www.perplexity.ai/library",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ora": "^8.1.1",
    "playwright": "^1.56.1",
    "puppeteer-core": "^24.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "perplexity",
    "exporter",
    "data-export",
    "backup",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kylebrodeur/perplexity-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/kylebrodeur/perplexity-exporter/issues"
  },
  "homepage": "https://github.com/kylebrodeur/perplexity-exporter#readme"
}
